logging {
  level = "info"
}

local.file_match "nginx_access" {
  path_targets = [{
    __path__ = "/var/log/nginx/*access*",
    job = "nginx",
    log_type = "access",
  }]
  sync_period = "5s"
}

local.file_match "nginx_error" {
  path_targets = [{
    __path__ = "/var/log/nginx/*error*",
    job = "nginx",
    log_type = "error",
  }]
  sync_period = "5s"
}

loki.source.file "nginx_access" {
  targets       = local.file_match.nginx_access.targets
  forward_to    = [loki.write.default.receiver]
  tail_from_end = true
}

loki.source.file "nginx_error" {
  targets       = local.file_match.nginx_error.targets
  forward_to    = [loki.write.default.receiver]
  tail_from_end = true
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
